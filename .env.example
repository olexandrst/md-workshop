# Скопіюйте у файл .env і за потреби змініть значення.

# Пароль ведучого (адмінки). ОБОВ'ЯЗКОВО змініть перед воркшопом.
ADMIN_PASSWORD=admin

# База даних. Якщо не задано, використовується локальний SQLite-файл instance/workshop.db.
# Приклад для локального Postgres:
# DATABASE_URL=postgresql://workshop:workshop@localhost:5432/workshop

# Секрет для підпису cookie. Якщо не задано, генерується автоматично і зберігається в instance/secret_key.
# SECRET_KEY=change-me

# Публічна адреса, яку кодуватиме QR-код (наприклад, при роботі через тунель).
# Якщо не задано, адресу визначено автоматично (для localhost підставляється IP комп'ютера в локальній мережі).
# PUBLIC_URL=https://workshop.example.com

# Завантажити демо-ідеї при першому створенні бази (true/false).
SEED_DEMO=true

# Порт для локального запуску (python run.py).
PORT=5000
